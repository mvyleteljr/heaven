#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-up}" in
  up) docker compose up --build --force-recreate -d --wait --wait-timeout 600 ;;
  down) docker compose down ;;
  logs) docker compose logs -f ;;
  check)
    docker compose build
    docker compose run --rm --no-deps -e OPENROUTER_API_KEY= frontier sh -ec '
      cargo fmt --check
      cargo test --locked
      cargo clippy --locked --all-targets -- -D warnings
      node --check web/app.js
      node --check web/run.js
      node --check web/run-view.js
      node --check web/run-carousel.js
      node --check web/run-world.js
      node --check web/run-structure.js
      node --test tests/*.test.mjs
      cargo run --locked -- doctor
    '
    ;;
  doctor) docker compose run --rm --no-deps -e OPENROUTER_API_KEY= frontier cargo run --locked -- doctor ;;
  check-onto)
    docker compose run --rm --no-deps -e OPENROUTER_API_KEY= frontier sh -ec '
      node scripts/test-harbor-onto.mjs
      cargo test --locked --test ontology --test harbor_onto --test institutions_http --test story_executor -- --include-ignored
    '
    ;;
  check-connected)
    docker compose run --rm --no-deps -e OPENROUTER_API_KEY= frontier sh -ec '
      cargo test --locked --test connected_world -- --ignored
      cargo test --locked --bin frontier connected_transport_ -- --ignored
    '

    ;;
  check-jit)
    docker compose run --rm --no-deps -e OPENROUTER_API_KEY= frontier sh -ec '
      cargo test --locked --test jit -- --ignored --nocapture
      cargo test --locked --bin frontier jit_ -- --ignored
    '
    ;;
  demo) docker compose run --rm --no-deps -e OPENROUTER_API_KEY= -e FRONTIER_DB=/tmp/demo.sqlite frontier cargo run --locked -- demo ;;
  *) echo 'Usage: scripts/dev {up|down|logs|check|doctor|demo|check-onto|check-jit|check-connected}' >&2; exit 2 ;;
esac
